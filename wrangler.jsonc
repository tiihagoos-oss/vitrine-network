
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitrine-network",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitrine-network-db",
      "database_id": "37191fb6-ff02-4f92-b8dd-35d5acf610a5"
    }
  ]
}
